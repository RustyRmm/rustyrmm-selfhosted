# Which optional services run:
#   tunnel   Cloudflare Tunnel; no inbound HTTP ports needed
#   caddy    HTTPS on this host via Let's Encrypt (ports 80/443 open)
# Remote desktop is built in. Add ",rustdesk" (e.g. tunnel,rustdesk) only if
# you also want the optional RustDesk add-on server.
COMPOSE_PROFILES=tunnel

# Public name of the console. With Caddy: a DNS record pointing at this host.
# With a tunnel: the public hostname configured on the tunnel in Cloudflare.
RMM_DOMAIN=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# Only with the rustdesk profile: name RustDesk clients use to reach the
# bundled RustDesk server; defaults to RMM_DOMAIN. With a tunnel, use a
# separate DNS-only (grey cloud) record pointing at this host, e.g.
# rustdesk.example.com.
RMM_RUSTDESK_HOST=

# Database password (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# First superuser. Leave the password empty to have one generated and printed
# once in `docker compose logs rustyrmm`.
RMM_ADMIN_EMAIL=admin@example.com
RMM_ADMIN_PASSWORD=

# Public half of the agent release signing key (from `rmm-release keygen`).
# Keep the secret half only in CI.
RMM_UPDATE_PUBKEY=83b01a6799b0cb82453ce1be85cdd0e17c7794755bdf158a483e0eb6b4b8b32f

# Pull signed agent builds automatically (optional). For a private repo add a
# fine-grained token with read access to its releases.
RMM_RELEASE_GITHUB_REPO=RustyRmm/rustyrmm-releases
